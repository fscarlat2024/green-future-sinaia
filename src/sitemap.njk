---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc></url>
  <url><loc>{{ site.url }}/en/</loc></url>
  <url><loc>{{ site.url }}/restaurant/</loc></url>
  <url><loc>{{ site.url }}/en/restaurant/</loc></url>
  <url><loc>{{ site.url }}/abonamente/</loc></url>
  <url><loc>{{ site.url }}/en/passes/</loc></url>
  <url><loc>{{ site.url }}/termeni/</loc></url>
  <url><loc>{{ site.url }}/en/terms/</loc></url>
  <url><loc>{{ site.url }}/confidentialitate/</loc></url>
  <url><loc>{{ site.url }}/en/privacy/</loc></url>
  <url><loc>{{ site.url }}/anulare/</loc></url>
  <url><loc>{{ site.url }}/en/cancellation/</loc></url>
  <url><loc>{{ site.url }}/ghid/</loc></url>
  {% for a in collections.ghid %}<url><loc>{{ site.url }}{{ a.url }}</loc><lastmod>{{ a.date.toISOString().slice(0, 10) }}</lastmod></url>
  {% endfor %}  {% for apt in collections.apartmentsRo %}<url><loc>{{ site.url }}{{ apt.url }}</loc></url>
  {% endfor %}{% for apt in collections.apartmentsEn %}<url><loc>{{ site.url }}{{ apt.url }}</loc></url>
  {% endfor %}
</urlset>
