{% set t = i18n[lang] %}
{% set home = "/" if lang == "ro" else "/en/" %}
<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or site.name }}</title>
  <meta name="description" content="{{ description or site[lang].intro }}">
  {% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {% if urlRo and urlEn %}
  <link rel="alternate" hreflang="ro" href="{{ site.url }}{{ urlRo }}">
  <link rel="alternate" hreflang="en" href="{{ site.url }}{{ urlEn }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ urlRo }}">
  {% endif %}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site[lang].intro }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or site.heroImage }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="theme-color" content="#0C110D">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Cpath d='M12 2C7 8 6 13 8 17c1.2 2.4 3 3.5 4 4 1-.5 2.8-1.6 4-4 2-4 1-9-4-15Z' fill='%232E6B47'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Figtree:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css?v={{ build }}">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LodgingBusiness",
    "name": "{{ site.name }}",
    "description": "{{ site[lang].intro }}",
    "address": { "@type": "PostalAddress", "streetAddress": "{{ site.address }}", "addressLocality": "Sinaia", "addressCountry": "RO" },
    "url": "{{ site.url }}",
    "image": "{{ site.url }}{{ site.heroImage }}",
    "amenityFeature": [
      { "@type": "LocationFeatureSpecification", "name": "Indoor pool", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Sauna", "value": true },
      { "@type": "LocationFeatureSpecification", "name": "Fitness room", "value": true }
    ]
  }
  </script>
</head>
<body>
  <header class="nav">
    <div class="wrap nav-in">
      <a href="{{ home }}" class="brand">
        <span class="lm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M12 2C7 8 6 13 8 17c1.2 2.4 3 3.5 4 4 1-.5 2.8-1.6 4-4 2-4 1-9-4-15Z" fill="currentColor"/><path d="M12 21V9" stroke="rgba(255,255,255,.55)" stroke-width="1.3" stroke-linecap="round"/></svg></span>
        <span><b>{{ site.shortName }}</b><small>Sinaia<span class="daisies" role="img" aria-label="{{ '4 margarete' if lang == 'ro' else '4 daisies' }}"><svg class="daisy" viewBox="0 0 24 24" aria-hidden="true"><g fill="currentColor"><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(0 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(45 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(90 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(135 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(180 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(225 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(270 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(315 12 12)"/></g><circle cx="12" cy="12" r="3.3" fill="#C8A45D" stroke="#0C110D" stroke-width="1"/></svg><svg class="daisy" viewBox="0 0 24 24" aria-hidden="true"><g fill="currentColor"><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(0 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(45 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(90 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(135 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(180 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(225 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(270 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(315 12 12)"/></g><circle cx="12" cy="12" r="3.3" fill="#C8A45D" stroke="#0C110D" stroke-width="1"/></svg><svg class="daisy" viewBox="0 0 24 24" aria-hidden="true"><g fill="currentColor"><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(0 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(45 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(90 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(135 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(180 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(225 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(270 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(315 12 12)"/></g><circle cx="12" cy="12" r="3.3" fill="#C8A45D" stroke="#0C110D" stroke-width="1"/></svg><svg class="daisy" viewBox="0 0 24 24" aria-hidden="true"><g fill="currentColor"><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(0 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(45 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(90 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(135 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(180 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(225 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(270 12 12)"/><ellipse cx="12" cy="5.5" rx="2.5" ry="4.6" transform="rotate(315 12 12)"/></g><circle cx="12" cy="12" r="3.3" fill="#C8A45D" stroke="#0C110D" stroke-width="1"/></svg></span></small></span>
      </a>
      <nav class="nav-links">
        {% if backLink %}<a href="{{ backLink }}" class="back-pill">&larr; <span class="hide-sm">{{ t.back_apts }}</span></a>{% endif %}
        <a href="{{ home }}#apartamente">{{ t.nav_apartments }}</a>
        <a href="{{ '/restaurant/' if lang == 'ro' else '/en/restaurant/' }}">Bistro</a>
        <a href="{{ '/abonamente/' if lang == 'ro' else '/en/passes/' }}">{{ "Abonamente" if lang == "ro" else "Passes" }}</a>
        <a href="{{ home }}#sinaia" class="hide-sm">{{ t.nav_sinaia }}</a>
        <a href="{{ '/cont/' if lang == 'ro' else '/en/account/' }}">{{ "Cont" if lang == "ro" else "Account" }}</a>
        {% if urlRo and urlEn %}
        <span class="lang-switch">
          <a href="{{ urlRo }}"{% if lang == "ro" %} class="on"{% endif %}>RO</a>
          <a href="{{ urlEn }}"{% if lang == "en" %} class="on"{% endif %}>EN</a>
        </span>
        {% endif %}
        <button class="theme-toggle" id="tt" aria-label="Theme" type="button">◐</button>
        <a href="{{ home }}#apartamente" class="btn btn-primary nav-book">{{ t.nav_book }}</a>
      </nav>
    </div>
    <nav class="m-nav" aria-label="Meniu">
      <a href="{{ home }}#apartamente">{{ t.nav_apartments }}</a>
      <a href="{{ '/restaurant/' if lang == 'ro' else '/en/restaurant/' }}">Bistro</a>
      <a href="{{ '/abonamente/' if lang == 'ro' else '/en/passes/' }}">{{ "Abonamente" if lang == "ro" else "Passes" }}</a>
      <a href="{{ home }}#sinaia">{{ t.nav_sinaia }}</a>
      <a href="{{ '/cont/' if lang == 'ro' else '/en/account/' }}">{{ "Cont" if lang == "ro" else "Account" }}</a>
    </nav>
  </header>

  {{ content | safe }}

  <footer>
    <div class="wrap">
      <div class="foot-grid">
        <div class="brand">
          <span class="lm" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 2C7 8 6 13 8 17c1.2 2.4 3 3.5 4 4 1-.5 2.8-1.6 4-4 2-4 1-9-4-15Z" fill="currentColor"/></svg></span>
          <span><b style="font-family:'Cormorant Garamond',serif;font-size:1.05rem">{{ site.name }}</b><small style="display:block;font-size:.62rem;letter-spacing:.3em;text-transform:uppercase;color:var(--muted)">{{ site.address }}</small></span>
        </div>
        <nav style="display:flex;gap:1.3rem;flex-wrap:wrap">
          <a href="{{ home }}#apartamente">{{ t.nav_apartments }}</a><a href="{{ '/restaurant/' if lang == 'ro' else '/en/restaurant/' }}">Bistro</a><a href="{{ '/abonamente/' if lang == 'ro' else '/en/passes/' }}">{{ "Abonamente" if lang == "ro" else "Passes" }}</a><a href="{{ home }}#sinaia">{{ t.nav_sinaia }}</a><a href="{{ home }}#proprietari">{{ t.nav_owners }}</a>
        </nav>
      </div>
      <p class="foot-credit">{{ "Foto:" if lang == "ro" else "Photo:" }} Castelul Peleș, <a href="{{ site.heroCredit.url }}" rel="noopener">{{ site.heroCredit.author }}, Wikimedia Commons</a>, {{ site.heroCredit.license }}</p>
    </div>
  </footer>

  <script src="/assets/js/theme.js?v={{ build }}" defer></script>
  <script src="/assets/js/slideshow.js?v={{ build }}" defer></script>
  <script src="/assets/js/app-native.js?v={{ build }}" defer></script>
  {% for s in scripts %}<script src="{{ s }}?v={{ build }}" defer></script>{% endfor %}
</body>
</html>
