---
layout: base.njk
---
{% set t = i18n[lang] %}
<main id="top" class="ap-top">
  <div class="ap-gallery">
    <div class="hero-slides" data-slideshow data-arrows data-noauto>
      <div class="hero-slide is-active" style="background-image:url('{{ hero }}')" role="img" aria-label="{{ name }}"></div>
      {% for g in gallery %}<div class="hero-slide" data-bg="{{ g.src }}" role="img" aria-label="{{ g['alt_' ~ lang] or name }}"></div>{% endfor %}
    </div>
  </div>
  <div class="wrap ap-head">
    <span class="loc-tag">{{ site.name }} · Sinaia</span>
    <h1>{{ name }}</h1>
    <p class="ap-sub">{{ capacity }} · {{ roomType }}{% if metaExtra %} · {{ metaExtra }}{% endif %}</p>
    {% if reviewScore %}<a class="apt-rev" href="#recenzii"><span class="apt-score">{{ reviewScore }}</span><span class="apt-rev-t"><b>{{ reviewWord_ro if lang == "ro" else reviewWord_en }}</b><small>{{ reviewCount }} {{ "recenzii pe Booking" if lang == "ro" else "reviews on Booking" }}</small></span></a>{% endif %}
    <p class="ap-tag">{{ tagline }}</p>
  </div>
</main>

{% if amenities and amenities.length %}
<section class="block" id="dotari">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">{{ t.ap_amen_eyebrow }}</span><h2>{{ t.ap_amen_title }}</h2></div>
    <div class="amen">
      {% for a in amenities %}<div><span class="ck">✓</span> {{ a }}</div>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if reviewScore %}
<section class="block" id="recenzii" style="background:var(--surface-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">{{ t.reviews_eyebrow }}</span><h2>{{ t.reviews_title }}</h2></div>
    <div class="reviews-wrap">
      <div class="review-score">
        <div class="rs-num">{{ reviewScore }}<span>/10</span></div>
        <div class="rs-meta">
          <b>{{ reviewWord_ro if lang == "ro" else reviewWord_en }}</b>
          <span class="rs-count">{{ reviewCount }} {{ t.reviews_of }} {{ t.reviews_on }}</span>
          {% if reviewsUrl %}<a href="{{ reviewsUrl }}" target="_blank" rel="noopener" class="btn btn-primary" style="margin-top:.7rem">{{ t.reviews_read }} →</a>{% endif %}
        </div>
      </div>
      {% if reviews and reviews.length %}
      <div class="review-quotes">
        {% for r in reviews %}<figure class="quote"><blockquote>{{ r['text_' ~ lang] or r.text }}</blockquote><figcaption>— {{ r.author }}</figcaption></figure>{% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<section class="block" id="despre">
  <div class="wrap article-intro">
    <span class="eyebrow">{{ t.ap_welcome }}</span>
    <div class="rich">
      {% for p in desc %}<p>{{ p }}</p>{% endfor %}
    </div>
  </div>
</section>

<section class="block" id="rezervare" style="padding-top:1rem">
  <div class="wrap">
    <div class="bk-section" data-direct-show hidden>
      <div class="sec-head">
        <span class="eyebrow">{{ t.ap_book_pill }}</span>
        <h2>{{ t.bk_title }}</h2>
        <p>{{ t.bk_sub }}</p>
      </div>
    </div>
    <div class="bk" id="bk" data-slug="{{ page.fileSlug }}" data-lang="{{ lang }}" hidden></div>
    <div class="band">
      <span class="pill" data-direct-hide>{{ t.ap_book_pill }}</span>
      <h2 data-direct-hide>{{ t.ap_book_prefix }} {{ name }}</h2>
      <p data-direct-hide>{{ t.ap_book_text }}</p>
      <h2 data-direct-show hidden>{{ t.bk_question }}</h2>
      <p data-direct-show hidden>{{ t.bk_question_text }}</p>
      {% if price %}<div class="price">{{ t.price_from }} <b>{{ price }}</b> {{ priceUnit }}</div>{% endif %}
      {% if t.price_note %}<p data-direct-hide style="color:rgba(255,255,255,.82);font-size:.84rem;margin:.35rem 0 0;max-width:44ch">{{ t.price_note }}</p>{% endif %}
      <div class="cta-row">
        {% if bookingUrl %}<a href="{{ bookingUrl }}" target="_blank" rel="noopener" class="btn btn-white btn-lg" data-direct-hide>{{ t.check_booking }}</a>{% endif %}
        <a href="{{ '/mesaje/' if lang == 'ro' else '/en/messages/' }}?p={{ page.fileSlug }}" class="btn btn-outline btn-lg">{{ "Scrie proprietarului" if lang == "ro" else "Message the owner" }}</a>
      </div>
    </div>
  </div>
</section>

<div class="ap-sticky" data-direct-show hidden>
  <div class="ap-sticky-price"><b data-ap-price></b><small data-ap-note></small></div>
  <a href="#rezervare" class="btn btn-primary">{{ "Vezi datele" if lang == "ro" else "See dates" }}</a>
</div>
