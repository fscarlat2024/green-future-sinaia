---
layout: base.njk
---
{% set t = i18n[lang] %}
<main id="top" class="ap-top">
  {% set gp = [hero] %}{% for g in gallery %}{% set gp = (gp.push(g.src), gp) %}{% endfor %}
  {% set q = reviews[0] if reviews and reviews.length else null %}
  {% set gdata = { photos: gp, name: name, score: reviewScore, count: reviewCount, url: bookingUrl, reviewsHref: "#recenzii", quote: (q['text_' ~ lang] if q else ""), author: (q.author if q else "") } %}
  <div class="pg-wrap" data-photo-grid data-photos="{{ gdata | dump | urlencode }}"></div>
  <div class="wrap ap-head">
    <div class="ap-info">
    <span class="loc-tag">{{ site.name }} · Sinaia</span>
    <h1>{{ name }}</h1>
    <p class="ap-sub">{{ capacity }} · {{ roomType }}{% if metaExtra %} · {{ metaExtra }}{% endif %}</p>
    {% if reviewScore %}<a class="apt-rev" href="#recenzii"><span class="apt-score">{{ reviewScore }}</span><span class="apt-rev-t"><b>{{ reviewWord_ro if lang == "ro" else reviewWord_en }}</b><small>{{ reviewCount }} {{ "recenzii pe Booking" if lang == "ro" else "reviews on Booking" }}</small></span></a>{% endif %}
    <p class="ap-tag">{{ tagline }}</p>
    </div>
    {% if story %}
    <aside class="ap-story{% if storyMotif %} has-motif{% endif %}">
      {% if storyMotif %}<img class="ap-story-flower" src="/assets/img/brand/papadie.svg" alt="" loading="lazy"><img class="ap-story-seeds" src="/assets/img/brand/seminte.svg" alt="" loading="lazy">{% endif %}
      <span class="eyebrow">{{ "Povestea acestui loc" if lang == "ro" else "The story of this place" }}</span>
      {% for p in story %}<p>{{ p }}</p>{% endfor %}
    </aside>
    {% endif %}
  </div>
</main>

{% if amenities and amenities.length %}
<section class="block" id="dotari">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">{{ t.ap_amen_eyebrow }}</span><h2>{{ t.ap_amen_title }}</h2></div>
    <div class="amen">
      {% for a in amenities %}<div><span class="ck">✓</span> {{ a }}</div>{% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if reviewScore %}
<section class="block" id="recenzii" style="background:var(--surface-2);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">{{ t.reviews_eyebrow }}</span><h2>{{ t.reviews_title }}</h2></div>
    <div class="reviews-wrap">
      <div class="review-score">
        <div class="rs-num">{{ reviewScore }}<span>/10</span></div>
        <div class="rs-meta">
          <b>{{ reviewWord_ro if lang == "ro" else reviewWord_en }}</b>
          <span class="rs-count">{{ reviewCount }} {{ t.reviews_of }} {{ t.reviews_on }}</span>
          {% if reviewsUrl %}<a href="{{ reviewsUrl }}" target="_blank" rel="noopener" class="btn btn-primary" style="margin-top:.7rem">{{ t.reviews_read }} →</a>{% endif %}
        </div>
      </div>
      {% if reviews and reviews.length %}
      <div class="review-quotes">
        {% for r in reviews %}<figure class="quote"><blockquote>{{ r['text_' ~ lang] or r.text }}</blockquote><figcaption>— {{ r.author }}</figcaption></figure>{% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<section class="block" id="recenzii-directe" hidden>
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">{{ "Rezervări directe" if lang == "ro" else "Direct bookings" }}</span>
      <h2>{{ "Recenzii de la oaspeții noștri" if lang == "ro" else "Reviews from our guests" }}</h2>
    </div>
    <div class="reviews-wrap">
      <div class="review-score"><div class="rs-num"><span id="direct-reviews-score" style="font:inherit;color:inherit"></span><span>/10</span></div><div class="rs-meta"><span class="rs-count" id="direct-reviews-count"></span></div></div>
      <div class="review-quotes" id="direct-reviews" data-slug="{{ page.fileSlug }}" data-lang="{{ lang }}"></div>
    </div>
  </div>
</section>

<section class="block" id="despre">
  <div class="wrap article-intro">
    <span class="eyebrow">{{ t.ap_welcome }}</span>
    <div class="rich">
      {% for p in desc %}<p>{{ p }}</p>{% endfor %}
    </div>
  </div>
</section>

<section class="block" id="rezervare" style="padding-top:1rem">
  <div class="wrap">
    <div class="band">
      <span class="pill">{{ t.ap_book_pill }}</span>
      <h2>{{ t.ap_book_prefix }} {{ name }}</h2>
      <p>{{ t.ap_book_text }}</p>
      <div class="cta-row">
        {% if bookingUrl %}<a href="{{ bookingUrl }}" target="_blank" rel="noopener" class="btn btn-white btn-lg">{{ t.check_booking }}</a>{% endif %}
        <a href="{{ '/mesaje/' if lang == 'ro' else '/en/messages/' }}?p={{ page.fileSlug }}" class="btn btn-outline btn-lg">{{ "Scrie proprietarului" if lang == "ro" else "Message the owner" }}</a>
      </div>
    </div>
  </div>
</section>
