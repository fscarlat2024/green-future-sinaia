---
pagination:
  data: languages
  size: 1
  alias: lang
permalink: "{{ '/index.html' if lang == 'ro' else '/en/index.html' }}"
layout: base.njk
scripts: ["/assets/js/search.js"]
eleventyComputed:
  title: "{{ site.name }} - {{ site[lang].tagline }}"
  description: "{{ site[lang].intro }}"
  urlRo: "/"
  urlEn: "/en/"
---
{% set t = i18n[lang] %}
{% set home = "/" if lang == "ro" else "/en/" %}
{% set apts = collections.apartmentsRo if lang == "ro" else collections.apartmentsEn %}

<main class="hero" id="top">
  <div class="hero-photo" style="background-image:url('{{ site.heroImage }}')" aria-hidden="true"></div>
  <div class="hero-veil" aria-hidden="true"></div>
  <div class="wrap hero-in">
    <span class="loc-tag">Sinaia · {{ site.address }}</span>
    <h1>{{ site[lang].tagline }}</h1>
    <p class="lead">{{ site[lang].intro }}</p>
    <div class="hero-cta">
      <a href="#apartamente" class="btn btn-ochre btn-lg">{{ t.hero_cta_apts }}</a>
      <a href="#experiente" class="btn btn-ghost btn-lg">{{ t.hero_cta_fac }}</a>
    </div>
    <form class="search" id="search" data-lang="{{ lang }}" hidden>
      <label><span>{{ t.bk_checkin }}</span><input type="date" name="checkin" required></label>
      <label><span>{{ t.bk_checkout }}</span><input type="date" name="checkout" required></label>
      <label><span>{{ t.bk_guests }}</span><select name="guests">{% for n in [1,2,3,4,5,6,7,8] %}<option value="{{ n }}"{% if n == 2 %} selected{% endif %}>{{ n }}</option>{% endfor %}</select></label>
      <button class="btn btn-ochre btn-lg" type="submit">{{ t.bk_search }}</button>
      <p class="search-msg" id="search-msg" role="status"></p>
    </form>
  </div>
</main>

<div class="wrap">
  <div class="facts">
    <div class="fact"><span class="fi">🏊</span><div><b>{{ t.fact_pool_t }}</b><span>{{ t.fact_pool_n }}</span></div></div>
    <div class="fact"><span class="fi">🏔️</span><div><b>{{ t.fact_view_t }}</b><span>{{ t.fact_view_n }}</span></div></div>
    <div class="fact"><span class="fi">🎿</span><div><b>{{ t.fact_slope_t }}</b><span>{{ t.fact_slope_n }}</span></div></div>
    <div class="fact"><span class="fi">🤝</span><div><b>{{ t.fact_book_t }}</b><span>{{ t.fact_book_n }}</span></div></div>
  </div>
</div>

<section class="block home-about" id="despre">
  <div class="wrap split about-split">
    <div class="copy">
      <span class="eyebrow">{{ t.about_eyebrow }}</span>
      <h2>{{ site[lang].about_title }}</h2>
      <p>{{ site[lang].about_p1 }}</p>
      <p>{{ site[lang].about_p2 }}</p>
      <p class="about-note">{{ site[lang].about_note }}</p>
    </div>
    <div class="collage" role="img" aria-label="{{ 'Piscina, bistroul și apartamentele din Green Future Sinaia' if lang == 'ro' else 'The pool, the bistro and the apartments at Green Future Sinaia' }}" data-collage='[{% for src in site.collage %}{% if loop.index > 3 %}"{{ src }}"{% if not loop.last %},{% endif %}{% endif %}{% endfor %}]'>
      {% for src in site.collage %}{% if loop.index <= 3 %}<div class="collage-tile"><img class="on" src="{{ src }}" alt="" loading="lazy"></div>{% endif %}{% endfor %}
    </div>
  </div>
</section>

<section class="block" id="apartamente" style="padding-top:1rem">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">{{ t.apts_eyebrow }}</span>
      <h2>{{ t.apts_title }}</h2>
      <p>{{ t.apts_sub }}</p>
    </div>
    <div class="combo" id="combo" hidden></div>
    <div class="apts">
      {% for apt in apts %}
      <article class="apt" data-slug="{{ apt.page.fileSlug }}">
        <div class="ph"><img src="{{ apt.data.hero }}" alt="" loading="lazy"></div>
        <div class="body">
          <h3><a href="{{ apt.url }}" class="apt-link">{{ apt.data.name }}</a></h3>
          <div class="meta"><span>{{ apt.data.capacity }}</span>{% if apt.data.metaExtra %}<span>·</span><span>{{ apt.data.metaExtra }}</span>{% endif %}</div>
          <p class="desc">{{ apt.data.tagline }}</p>
          <span class="tagpill">{{ t.available }}</span>
        </div>
        <div class="apt-side">
          {% if apt.data.price %}<div class="price"><b>{{ apt.data.price }}</b> <small>{{ apt.data.priceUnit }}</small></div>{% else %}<div class="price"><small>{{ "Preț pe Booking" if lang == "ro" else "Price on Booking" }}</small></div>{% endif %}
          {% if apt.data.reviewScore %}<a class="apt-rev" href="{{ apt.url }}#recenzii"><span class="apt-score">{{ apt.data.reviewScore }}</span><span class="apt-rev-t"><b>{{ apt.data["reviewWord_" + lang] }}</b><small>{{ apt.data.reviewCount }} {{ "recenzii pe Booking" if lang == "ro" else "reviews on Booking" }}</small></span></a>{% endif %}
          <span class="btn btn-primary apt-go">{{ t.view_apt }}</span>
        </div>
      </article>
      {% endfor %}

      <article class="apt">
        <div class="ph apt-soon">{{ t.soon }}</div>
        <div class="body">
          <h3>{{ t.soon_name }}</h3>
          <div class="meta"><span>{{ t.soon_cap }}</span></div>
          <p class="desc">{{ t.soon_desc }}</p>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="block" id="experiente" style="padding-top:1rem">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">{{ "În complex" if lang == "ro" else "In the complex" }}</span>
      <h2>{{ "Totul, la câțiva pași de apartament" if lang == "ro" else "Everything, steps from your apartment" }}</h2>
    </div>
    <div class="exp">
      <a class="exp-card" href="{{ '/restaurant/' if lang == 'ro' else '/en/restaurant/' }}" style="background-image:url('/assets/img/complex/bistro.jpg')">
        <span class="exp-kicker">Attitude Bistro</span>
        <b>{{ "Meniu și comandă la cameră" if lang == "ro" else "Menu and room orders" }}</b>
        <span>{{ "Vezi preparatele și comanzi la apartament, cu plata pe nota camerei." if lang == "ro" else "See the dishes and order to your apartment, added to your room bill." }}</span>
        <em>{{ "Deschide meniul" if lang == "ro" else "Open the menu" }} →</em>
      </a>
      <a class="exp-card" href="{{ '/abonamente/#spa' if lang == 'ro' else '/en/passes/#spa' }}" style="background-image:url('/assets/img/complex/pool.jpg')">
        <span class="exp-kicker">Spa</span>
        <b>{{ "Piscină, saune, jacuzzi" if lang == "ro" else "Pool, saunas, jacuzzi" }}</b>
        <span>{{ "Intrări și abonamente." if lang == "ro" else "Single entries and passes." }}</span>
        <em>{{ "Vezi tarifele" if lang == "ro" else "See the prices" }} →</em>
      </a>
      <a class="exp-card" href="{{ '/abonamente/#sala' if lang == 'ro' else '/en/passes/#sala' }}" style="background-image:url('/assets/img/complex/gym.jpg')">
        <span class="exp-kicker">Fitness</span>
        <b>{{ "Sală deschisă zilnic" if lang == "ro" else "Gym open daily" }}</b>
        <span>{{ "Abonamente lunare și intrări de o zi." if lang == "ro" else "Monthly passes and day entries." }}</span>
        <em>{{ "Vezi tarifele" if lang == "ro" else "See the prices" }} →</em>
      </a>
    </div>
  </div>
</section>

<section class="block" id="sinaia">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">{{ t.sinaia_eyebrow }}</span>
      <h2>{{ site[lang].sinaia_title }}</h2>
      <p>{{ t.sinaia_sub }}</p>
    </div>
    <div class="attr-cards">
      {% for a in site.attractions %}
      <div class="attr-card">
        <img src="{{ a.img }}" alt="{{ a[lang].name }}" loading="lazy">
        <span class="veil"></span>
        <span class="cap"><b>{{ a[lang].name }}</b><span>{{ a[lang].desc }}</span></span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="block" id="proprietari" style="padding-top:1rem">
  <div class="wrap">
    <div class="band">
      <span class="pill">🤝 {{ t.owners_pill }}</span>
      <h2>{{ t.owners_title }}</h2>
      <p>{{ t.owners_text }}</p>
      <a href="mailto:{{ site.email }}" class="btn btn-white btn-lg">{{ t.owners_btn }}</a>
    </div>
  </div>
</section>
