{
  // Site static (_site) + API de rezervari (worker/). Worker-ul ruleaza doar pe /api si /ical.
  "name": "greenfuturesinaia",
  "account_id": "78736e65e05040f02249d29ead996c64",
  "main": "worker/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ical/*"]
  },
  "vars": {
    "SITE_URL": "https://greenfuturesinaia.com",
    "MAIL_FROM": "rezervari@greenfuturesinaia.com",
    "APNS_TOPIC": "com.greenfuturesinaia.app",
    "APNS_KEY_ID": "73UUH9L343",
    "APNS_TEAM_ID": "L22K2CY58S"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "green-future",
      "database_id": "601c475e-d6ee-43ba-9cae-cc9ba7c23629",
      "migrations_dir": "migrations"
    }
  ],
  // fara cron: contul a atins limita gratuita de 5; vezi maintain() in worker/index.js
  "observability": { "enabled": true }
}
